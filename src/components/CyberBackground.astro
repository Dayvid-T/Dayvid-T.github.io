---
// Full-page animated backdrop: a faint perspective grid plus a slow
// particle network in navy and wood tones. Static under reduced motion.
---

<div class="bg" aria-hidden="true">
  <div class="bg-grid"></div>
  <div class="bg-glow"></div>
  <canvas id="bg-net"></canvas>
  <div class="bg-vignette"></div>
</div>

<style>
  .bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: var(--bg);
  }

  .bg-grid {
    position: absolute;
    inset: -40% -20% -10%;
    background-image:
      linear-gradient(rgba(111, 149, 201, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(111, 149, 201, 0.07) 1px, transparent 1px);
    background-size: 64px 64px;
    transform: perspective(900px) rotateX(62deg) translateY(-8%);
    transform-origin: 50% 0;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.9), transparent 70%);
  }

  .bg-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 45% at 20% 0%, rgba(193, 128, 63, 0.16), transparent 70%),
      radial-gradient(50% 40% at 85% 10%, rgba(21, 31, 48, 0.9), transparent 70%),
      radial-gradient(70% 50% at 50% 100%, rgba(15, 22, 34, 0.8), transparent 70%);
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .bg-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 90% at 50% 40%, transparent 55%, rgba(0, 0, 0, 0.55) 100%);
  }
</style>

<script>
  const canvas = document.getElementById("bg-net") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  interface Node {
    x: number;
    y: number;
    vx: number;
    vy: number;
    r: number;
    warm: boolean;
  }

  let nodes: Node[] = [];
  let width = 0;
  let height = 0;
  let dpr = 1;
  let raf = 0;

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    width = window.innerWidth;
    height = window.innerHeight;
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const count = Math.round(Math.min(90, (width * height) / 16000));
    nodes = Array.from({ length: count }, () => ({
      x: Math.random() * width,
      y: Math.random() * height,
      vx: (Math.random() - 0.5) * 0.18,
      vy: (Math.random() - 0.5) * 0.18,
      r: 1 + Math.random() * 1.4,
      warm: Math.random() < 0.28,
    }));
  }

  function step() {
    ctx.clearRect(0, 0, width, height);
    const linkDist = 150;

    for (const n of nodes) {
      if (!reduce) {
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < -10) n.x = width + 10;
        if (n.x > width + 10) n.x = -10;
        if (n.y < -10) n.y = height + 10;
        if (n.y > height + 10) n.y = -10;
      }
    }

    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const a = nodes[i];
        const b = nodes[j];
        const dx = a.x - b.x;
        const dy = a.y - b.y;
        const d = Math.hypot(dx, dy);
        if (d > linkDist) continue;
        const alpha = (1 - d / linkDist) * 0.22;
        ctx.strokeStyle =
          a.warm && b.warm ? `rgba(193,128,63,${alpha})` : `rgba(111,149,201,${alpha})`;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.stroke();
      }
    }

    for (const n of nodes) {
      ctx.fillStyle = n.warm ? "rgba(217,154,85,0.75)" : "rgba(111,149,201,0.6)";
      ctx.beginPath();
      ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
      ctx.fill();
    }

    if (!reduce) raf = requestAnimationFrame(step);
  }

  function start() {
    cancelAnimationFrame(raf);
    step();
  }

  window.addEventListener("resize", () => {
    resize();
    start();
  });
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) cancelAnimationFrame(raf);
    else start();
  });

  resize();
  start();
</script>
