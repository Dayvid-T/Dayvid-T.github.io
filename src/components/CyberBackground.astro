---
// Full-page matte backdrop: flat navy wash, faint perspective grid, a fine
// grain overlay, and a slow particle network in slate/wood tones. Static
// under reduced motion.
---

<div class="bg" aria-hidden="true">
  <div class="bg-wash"></div>
  <div class="bg-grid"></div>
  <div class="bg-scrim"></div>
  <canvas id="bg-net"></canvas>
  <div class="bg-grain"></div>
  <div class="bg-vignette"></div>
</div>

<style>
  .bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: var(--bg);
  }

  /* Flat, low-contrast washes instead of glossy glows. */
  .bg-wash {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, #0d1522 0%, var(--bg) 42%, #0b1018 100%),
      radial-gradient(70% 40% at 15% 0%, rgba(185, 130, 64, 0.07), transparent 70%);
    background-blend-mode: normal, screen;
  }

  .bg-grid {
    position: absolute;
    inset: -40% -20% -10%;
    background-image:
      linear-gradient(rgba(122, 162, 216, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(122, 162, 216, 0.06) 1px, transparent 1px);
    background-size: 64px 64px;
    transform: perspective(900px) rotateX(62deg) translateY(-8%);
    transform-origin: 50% 0;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.8), transparent 70%);
  }

  /* Sits between the wash/grid and the particle canvas: a translucent
     charcoal-grey pane that mattes the backdrop down to a flat, opaque
     grey - dark enough that text and cards stay readable over it -
     without touching the particles painted on top of it, so the
     constellation stays fully visible. */
  .bg-scrim {
    position: absolute;
    inset: 0;
    background: rgba(40, 43, 50, 0.55);
    backdrop-filter: blur(6px);
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Fine monochrome noise gives the flat colour a matte, paper-like finish. */
  .bg-grain {
    position: absolute;
    inset: 0;
    opacity: 0.16;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.6  0 0 0 0 0.65  0 0 0 0 0.75  0 0 0 0.5 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    background-size: 160px 160px;
  }

  .bg-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 90% at 50% 40%, transparent 65%, rgba(20, 22, 28, 0.4) 100%);
  }
</style>

<script>
  const canvas = document.getElementById("bg-net") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  interface Node {
    x: number;
    y: number;
    vx: number;
    vy: number;
    r: number;
    warm: boolean;
  }

  let nodes: Node[] = [];
  let width = 0;
  let height = 0;
  let dpr = 1;
  let raf = 0;

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    width = window.innerWidth;
    height = window.innerHeight;
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const count = Math.round(Math.min(90, (width * height) / 16000));
    nodes = Array.from({ length: count }, () => ({
      x: Math.random() * width,
      y: Math.random() * height,
      vx: (Math.random() - 0.5) * 0.16,
      vy: (Math.random() - 0.5) * 0.16,
      r: 1 + Math.random() * 1.3,
      warm: Math.random() < 0.22,
    }));
  }

  function step() {
    ctx.clearRect(0, 0, width, height);
    const linkDist = 150;

    for (const n of nodes) {
      if (!reduce) {
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < -10) n.x = width + 10;
        if (n.x > width + 10) n.x = -10;
        if (n.y < -10) n.y = height + 10;
        if (n.y > height + 10) n.y = -10;
      }
    }

    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const a = nodes[i];
        const b = nodes[j];
        const dx = a.x - b.x;
        const dy = a.y - b.y;
        const d = Math.hypot(dx, dy);
        if (d > linkDist) continue;
        const alpha = (1 - d / linkDist) * 0.26;
        ctx.strokeStyle =
          a.warm && b.warm ? `rgba(210,154,88,${alpha})` : `rgba(210,216,226,${alpha})`;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.stroke();
      }
    }

    for (const n of nodes) {
      ctx.fillStyle = n.warm ? "rgba(226,172,102,0.85)" : "rgba(222,227,235,0.7)";
      ctx.beginPath();
      ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
      ctx.fill();
    }

    if (!reduce) raf = requestAnimationFrame(step);
  }

  function start() {
    cancelAnimationFrame(raf);
    step();
  }

  window.addEventListener("resize", () => {
    resize();
    start();
  });
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) cancelAnimationFrame(raf);
    else start();
  });

  resize();
  start();
</script>
