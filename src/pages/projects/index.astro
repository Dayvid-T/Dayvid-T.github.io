---
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { allProjects } from "../../lib/projects";

const projects = await allProjects();
---

<Base title="Projects" description="Everything I've built, newest first.">
  <section class="page">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow"><span class="n">01</span>Projects</p>
          <h2>All projects.</h2>
        </div>
        <span class="link-arrow">{projects.length} total</span>
      </div>
      <div class="grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .page {
    padding: 72px 0 96px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px 28px;
  }
</style>
