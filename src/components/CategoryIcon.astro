---
import type { CategoryId } from "../categories";

interface Props {
  id: CategoryId;
}

const { id } = Astro.props;
---

<svg class="cat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {id === "ai" && (
    <>
      <rect x="7" y="7" width="10" height="10" rx="2" />
      <path d="M10 10h4v4h-4z M12 3v4 M12 17v4 M3 12h4 M17 12h4 M6 6l1.5 1.5 M18 6l-1.5 1.5 M6 18l1.5-1.5 M18 18l-1.5-1.5" />
    </>
  )}
  {id === "cybersec" && (
    <>
      <path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6l7-3z" />
      <path d="M9 12l2 2 4-4" />
    </>
  )}
  {id === "info-management" && (
    <>
      <ellipse cx="12" cy="6" rx="7" ry="3" />
      <path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6" />
      <path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6" />
    </>
  )}
</svg>

<style>
  .cat-icon {
    width: 26px;
    height: 26px;
  }
</style>
