---
// Ring-and-dot cursor. The dot tracks the pointer exactly; the ring eases
// behind it and grows over interactive elements. Disabled on touch devices.
---

<div class="cursor-ring" aria-hidden="true"><i class="pulse"></i></div>
<div class="cursor-dot" aria-hidden="true"></div>

<style>
  .cursor-ring,
  .cursor-dot {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 9999;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 0.25s;
  }

  .cursor-ring {
    width: 44px;
    height: 44px;
    border: 1px solid rgba(232, 227, 220, 0.55);
    background: rgba(232, 227, 220, 0.03);
    transition: opacity 0.25s, width 0.2s, height 0.2s, border-color 0.2s, background 0.2s;
  }

  /* A second ring that expands and fades on a loop, so the cursor breathes
     even while the pointer is still. */
  .pulse {
    position: absolute;
    inset: -1px;
    border-radius: 50%;
    border: 1px solid rgba(217, 154, 85, 0.7);
    animation: pulse 2.2s ease-out infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(0.85);
      opacity: 0.9;
    }
    70% {
      transform: scale(1.55);
      opacity: 0;
    }
    100% {
      transform: scale(1.55);
      opacity: 0;
    }
  }

  .cursor-dot {
    width: 7px;
    height: 7px;
    background: var(--wood-2);
    box-shadow: 0 0 10px rgba(217, 154, 85, 0.8);
    animation: glow 2.2s ease-in-out infinite;
  }

  @keyframes glow {
    0%,
    100% {
      transform: translate(-50%, -50%) scale(1);
      box-shadow: 0 0 8px rgba(217, 154, 85, 0.6);
    }
    50% {
      transform: translate(-50%, -50%) scale(1.35);
      box-shadow: 0 0 16px rgba(217, 154, 85, 1);
    }
  }

  body.cursor-hover .pulse {
    animation-duration: 1.1s;
    border-color: var(--wood-2);
  }

  body.has-cursor .cursor-ring,
  body.has-cursor .cursor-dot {
    opacity: 1;
  }

  body.cursor-hover .cursor-ring {
    width: 64px;
    height: 64px;
    border-color: var(--wood);
    background: var(--wood-dim);
  }

  body.cursor-down .cursor-ring {
    width: 36px;
    height: 36px;
  }

  @media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
    .cursor-ring,
    .cursor-dot {
      display: none;
    }
  }
</style>

<script>
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (fine && !reduce) {
    const ring = document.querySelector<HTMLElement>(".cursor-ring")!;
    const dot = document.querySelector<HTMLElement>(".cursor-dot")!;
    const body = document.body;

    let x = window.innerWidth / 2;
    let y = window.innerHeight / 2;
    let rx = x;
    let ry = y;
    let shown = false;

    window.addEventListener("pointermove", (e) => {
      x = e.clientX;
      y = e.clientY;
      dot.style.left = `${x}px`;
      dot.style.top = `${y}px`;
      if (!shown) {
        shown = true;
        rx = x;
        ry = y;
        body.classList.add("has-cursor");
      }
      const target = (e.target as Element | null)?.closest("a, button, [data-cursor]");
      body.classList.toggle("cursor-hover", !!target);
    });

    document.addEventListener("pointerdown", () => body.classList.add("cursor-down"));
    document.addEventListener("pointerup", () => body.classList.remove("cursor-down"));
    document.addEventListener("mouseleave", () => body.classList.remove("has-cursor"));
    document.addEventListener("mouseenter", () => shown && body.classList.add("has-cursor"));

    function tick() {
      rx += (x - rx) * 0.16;
      ry += (y - ry) * 0.16;
      ring.style.left = `${rx}px`;
      ring.style.top = `${ry}px`;
      requestAnimationFrame(tick);
    }
    tick();
  }
</script>
